# ==========================================
# MusicApp 环境变量配置示例
# 复制此文件为 .env 并按需修改
# ==========================================

# ── 数据库连接 DATABASE_URL ─────────────────────────────────────────────
# 格式: mysql://用户名:密码@主机:端口/数据库名
#
# • Docker 部署（backend 在容器里跑）：
#   不需要在 .env 里写 DATABASE_URL，docker-compose.yml 已为 backend 容器注入：
#   mysql://root:${MYSQL_ROOT_PASSWORD}@mysql:3306/musicapp
#   其中的主机名 "mysql" 是 Docker 网络里的 MySQL 服务名（即容器内 MySQL），不是本机。
#
# • 本地开发（backend 在本机跑，如 npm run dev）：
#   若要连 Docker 里的 MySQL，需在 docker-compose 中把 MySQL 的 3306 映射到宿主机，
#   例如 ports: - "3306:3306"，然后此处填：
#   DATABASE_URL="mysql://root:你的密码@localhost:3306/musicapp"
#   若本机另有 MySQL 实例，主机/端口按实际填写。
#
# DATABASE_URL="mysql://root:你的密码@localhost:3306/musicapp"

# ── MySQL 数据库（Docker 里 MySQL 容器的环境变量）────────────────────────
MYSQL_ROOT_PASSWORD=YourStrongRootPassword
MYSQL_PASSWORD=YourStrongPassword

# ── JWT 认证密钥（生产环境务必改为长随机字符串）──
# 生成方法: openssl rand -base64 48
JWT_SECRET=please-change-this-very-long-secret-in-production-env

# ── 音乐根目录 ─────────────────────────────
# Docker 部署时: 保持 /music 不变（容器内路径）
# 本地开发(Windows): 改为绝对路径, 如 E:\Projects\MusicApp\backend\music
# 本地开发(Linux/Mac): 改为绝对路径, 如 /home/user/music
MUSIC_ROOT_PATH=/music

# ── API 地址 ──────────────────────────────
# 前端访问后端的地址
# 本地开发: http://localhost:3001
# 公网服务器: https://your-domain.com
# 局域网 NAS: http://192.168.1.x:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── CORS 配置 ─────────────────────────────
# 后端允许的前端来源
# 本地开发: http://localhost:3000
# 公网服务器: https://your-domain.com
FRONTEND_URL=http://localhost:3000

# ── 外站音源搜索（可选）───────────────────
# 需要自行部署 NeteaseCloudMusicApi
# 项目地址: https://github.com/Binaryify/NeteaseCloudMusicApi
# 本地部署后填写: http://localhost:3000 或 http://netease-api:3000
NETEASE_API_URL=
# 网易云音乐 Cookie（用于获取完整音质，可不填）
NETEASE_COOKIE=

# ── 云端网盘音源（可选）───────────────────
# Google Drive：使用服务账号 JSON（整份粘贴或填路径）
# 获取方式：Google Cloud Console → 凭据 → 创建服务账号 → 密钥 → JSON
# 文档：https://developers.google.com/drive/api/guides/about-sdk
GOOGLE_DRIVE_CREDENTIALS=
# 默认列举的文件夹 ID，不填则用 root
GOOGLE_DRIVE_FOLDER_ID=

# OneDrive (Microsoft Graph)：OAuth2 应用凭据 + 刷新令牌
# 获取方式：Azure 门户 → 应用注册 → 新建 → API 权限添加 Files.Read
# 文档：https://learn.microsoft.com/en-us/graph/api/driveitem-get-content
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
# 通过 OAuth 授权一次后得到的 refresh_token，用于后端代取访问令牌
ONEDRIVE_REFRESH_TOKEN=
