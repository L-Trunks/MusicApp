DATABASE_URL="mysql://root:root@localhost:3306/musicapp"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
PORT=3001

# 音乐根目录
# Docker 部署时: /music（由 docker-compose.yml 挂载）
# 本地 Windows 开发: E:\Projects\MusicApp\backend\music
# 本地 Linux/Mac 开发: /path/to/music
MUSIC_ROOT_PATH=/music

FRONTEND_URL="http://localhost:3000"
NODE_ENV=development

# 外站音源搜索（可选）
# 需要自行部署 NeteaseCloudMusicApi: https://github.com/Binaryify/NeteaseCloudMusicApi
NETEASE_API_URL=
# 网易云音乐 Cookie（可留空）
NETEASE_COOKIE=
