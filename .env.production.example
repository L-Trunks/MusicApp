# ==========================================
# MusicApp 生产环境构建/运行时环境变量
# 复制此文件为 .env.production，用于「生产环境构建」镜像
# 本地构建（默认）使用 .env，生产构建使用本文件
# ==========================================
# 使用方式：
#   - 本地构建（默认）：docker compose build   （读取 .env）
#   - 生产构建：        docker compose --env-file .env.production build
# ==========================================

# ── MySQL（Docker 里 MySQL 容器）────────────────────────────────────────
MYSQL_ROOT_PASSWORD=YourStrongRootPassword
MYSQL_PASSWORD=YourStrongPassword

# ── JWT 认证密钥（务必改为长随机字符串）──────────────────────────────────
JWT_SECRET=please-change-this-very-long-secret-in-production-env

# ── 音乐根目录（Docker 部署保持 /music）──────────────────────────────────
MUSIC_ROOT_PATH=/music

# ── 前端构建时注入的 API 地址（生产域名）──────────────────────────────────
# 构建阶段写入前端，用户浏览器将请求此地址
# 示例：https://music.yourdomain.com 或 https://api.yourdomain.com
NEXT_PUBLIC_API_URL=https://music.yourdomain.com

# ── CORS：后端允许的前端来源（生产域名）──────────────────────────────────
FRONTEND_URL=https://music.yourdomain.com

# ── 外站音源搜索（可选）──────────────────────────────────────────────────
NETEASE_API_URL=
NETEASE_COOKIE=

# ── 云端网盘（可选）──────────────────────────────────────────────────────
GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_DRIVE_FOLDER_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REFRESH_TOKEN=

